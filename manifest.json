{
  "manifest_version": 3,
  "name": "Living GCal",
  "version": "0.2.1",
  "description": "A bullet-journal style weekly planner for Google Calendar.",
  "browser_specific_settings": {
    "gecko": {
      "id": "living-gcal@example.local"
    }
  },
  "action": {
    "default_title": "Open Living GCal",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "scripts": [
      "src/background.js"
    ]
  },
  "permissions": [
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://tasks.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
